// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────

enum UserRole {
  admin
  dispatcher
  customer
  driver

  @@map("user_role")
}

enum TruckStatus {
  Available
  Busy
  Maintenance
  Pending_Verification @map("Pending Verification")
  Unavailable

  @@map("truck_status")
}

enum RequestStatus {
  Pending
  Awaiting_Approval @map("Awaiting Approval")
  Quote_Rejected    @map("Quote Rejected")
  Approved
  Assigned
  En_Route_to_Pickup @map("En Route to Pickup")
  Arrived_at_Pickup  @map("Arrived at Pickup")
  Picked_Up          @map("Picked Up")
  In_Transit         @map("In Transit")
  Near_Destination   @map("Near Destination")
  Delivered
  Cancelled

  @@map("request_status")
}

enum PriceAdjustmentType {
  Increase
  Discount
  Fixed

  @@map("price_adjustment_type")
}

enum TripStatus {
  Pending
  Assigned
  En_Route_to_Pickup @map("En Route to Pickup")
  Arrived_at_Pickup  @map("Arrived at Pickup")
  Picked_Up          @map("Picked Up")
  In_Transit         @map("In Transit")
  Near_Destination   @map("Near Destination")
  Delivered
  Cancelled

  @@map("trip_status")
}

enum PaymentStatus {
  Pending
  Partial
  Paid
  Failed
  Refunded

  @@map("payment_status")
}

enum EarningRole {
  driver
  dispatcher
  platform

  @@map("earning_role")
}

enum EarningStatus {
  Available
  PaidOut

  @@map("earning_status")
}

enum CargoLoadType {
  FTL
  SHARED

  @@map("cargo_load_type")
}

enum DriverServiceType {
  FTL
  SHARED

  @@map("driver_service_type")
}

// ─── Models ──────────────────────────────────────────────────────────

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(150)
  username     String   @unique @db.VarChar(30)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  role         UserRole
  phone        String?  @unique @db.VarChar(20)
  avatarUrl    String?  @map("avatar_url")
  avatarPublicId String? @map("avatar_public_id")
  nationalIdNumber String? @unique @map("national_id_number") @db.VarChar(50)
  driverLicense String? @map("driver_license") @db.VarChar(50)
  driverLicenseUrl String? @map("driver_license_url")
  driverLicensePublicId String? @map("driver_license_public_id")
  driverImageUrl String? @map("driver_image_url")
  driverImagePublicId String? @map("driver_image_public_id")
  serviceType    DriverServiceType?  @map("service_type")
  status       String   @default("Active") @db.VarChar(40)
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz()
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz()
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  createdBy             User?          @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers          User[]         @relation("UserCreatedBy")
  truck                 Truck?
  cargoRequestsAsCustomer  CargoRequest[] @relation("CargoRequestCustomer")
  cargoRequestsAsDriver    CargoRequest[] @relation("CargoRequestDriver")
  cargoRequestsAsDispatcher CargoRequest[] @relation("CargoRequestDispatcher")
  tripsAsCustomer       Trip[]         @relation("TripCustomer")
  tripsAsDriver         Trip[]         @relation("TripDriver")
  tripsAsDispatcher     Trip[]         @relation("TripDispatcher")
  notifications         Notification[]
  paymentsAsCustomer    Payment[]      @relation("PaymentCustomer")
  earningsAsRecipient   Earning[]      @relation("EarningRecipient")
  auditLogs             AuditLog[]
  feedbackAsCustomer    TripFeedback[] @relation("FeedbackCustomer")
  feedbackAsDriver      TripFeedback[] @relation("FeedbackDriver")
  customerProfile       CustomerProfile?
  smsNotificationsSent  SmsNotification[] @relation("SmsSentBy")
  supportComplaintsFiled SupportComplaint[] @relation("SupportComplaintCustomer")
  supportComplaintsAgainst SupportComplaint[] @relation("SupportComplaintAgainst")
  sharedTrips          SharedTrip[]
  sharedTripBookings   SharedTripBooking[]
  phoneBookingsAssigned CargoRequest[] @relation("PhoneBookingAssignedBy")

  @@index([name], map: "idx_users_name")
  @@index([role], map: "idx_users_role")
  @@index([role, status], map: "idx_users_role_status")
  @@index([createdById], map: "idx_users_created_by")
  @@map("users")
}

model CustomerProfile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  customerType String   @map("customer_type") @db.VarChar(40)
  city         String   @db.VarChar(100)
  address      String?  @db.VarChar(255)
  profilePhotoUrl String? @map("profile_photo_url")
  profilePhotoPublicId String? @map("profile_photo_public_id")
  companyName  String?  @map("company_name") @db.VarChar(100)
  companyPhone String?  @map("company_phone") @db.VarChar(20)
  companyAddress String? @map("company_address") @db.VarChar(255)
  businessRegistrationNumber String? @map("business_registration_number") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerType, city])
  @@map("customer_profiles")
}

model Truck {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  truckNumber String      @map("truck_number") @db.VarChar(50)
  plateNumber String      @unique @map("plate_number") @db.VarChar(30)
  capacity    String      @db.VarChar(30)
  capacityTons Decimal?   @map("capacity_tons") @db.Decimal(12, 2)
  truckType   String      @map("truck_type") @db.VarChar(100)
  photoUrl1   String?     @map("photo_url_1")
  photoUrl2   String?     @map("photo_url_2")
  photoPublicId1 String?   @map("photo_public_id_1")
  photoPublicId2 String?   @map("photo_public_id_2")
  registrationDocumentUrl String? @map("registration_document_url")
  registrationDocumentPublicId String? @map("registration_document_public_id")
  documentUrls String[]   @default([]) @map("document_urls")
  region      String      @default("") @db.VarChar(100)
  city        String      @default("") @db.VarChar(100)
  driverId    String      @unique @map("driver_id") @db.Uuid
  status      TruckStatus @default(Available)
  lastLat     Float?      @map("last_lat")
  lastLng     Float?      @map("last_lng")
  lastLocationAt DateTime? @map("last_location_at") @db.Timestamptz()
  lastSpeedKmh Float?     @map("last_speed_kmh")
  lastHeading Float?      @map("last_heading")
  gpsStatus   String      @default("OFFLINE") @map("gps_status") @db.VarChar(20)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  driver        User           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  cargoRequests CargoRequest[]
  trips         Trip[]
  sharedTrips   SharedTrip[]
  tripEvents    TripEvent[]

  @@index([status], map: "idx_trucks_status")
  @@index([gpsStatus], map: "idx_trucks_gps_status")
  @@index([lastLocationAt], map: "idx_trucks_last_location")
  @@map("trucks")
}

model CargoRequest {
  id                    String        @id
  customerId            String        @map("customer_id") @db.Uuid
  pickup                String        @db.VarChar(255)
  destination           String        @db.VarChar(255)
  truckType             String        @map("truck_type") @db.VarChar(100)
  cargoType             String?       @map("cargo_type") @db.VarChar(100)
  measuredQuantity      Decimal?      @map("measured_quantity") @db.Decimal(14, 3)
  measurementUnit       String?       @map("measurement_unit") @db.VarChar(20)
  weight                String        @db.VarChar(30)
  description           String
  receiver              String?       @db.VarChar(150)
  sender                String?       @db.VarChar(150)
  customerRole          String?       @map("customer_role") @db.VarChar(20)
  senderName            String?       @map("sender_name") @db.VarChar(150)
  senderPhone           String?       @map("sender_phone") @db.VarChar(20)
  receiverName          String?       @map("receiver_name") @db.VarChar(150)
  receiverPhone         String?       @map("receiver_phone") @db.VarChar(20)
  fromRegion            String?       @map("from_region") @db.VarChar(100)
  fromDistrict          String?       @map("from_district") @db.VarChar(100)
  fromNeighborhood      String?       @map("from_neighborhood") @db.VarChar(100)
  toRegion              String?       @map("to_region") @db.VarChar(100)
  toDistrict            String?       @map("to_district") @db.VarChar(100)
  toNeighborhood        String?       @map("to_neighborhood") @db.VarChar(100)
  submissionKey         String?       @unique @map("submission_key") @db.Uuid
  specialInstructions   String?       @map("special_instructions")
  preferredPickupDate   DateTime?     @map("preferred_pickup_date") @db.Date
  distanceKm            Decimal?      @map("distance_km") @db.Decimal(12, 2)
  calculatedPrice       Decimal?      @map("calculated_price") @db.Decimal(12, 2)
  adjustmentType        PriceAdjustmentType? @map("adjustment_type")
  adjustmentAmount      Decimal?      @map("adjustment_amount") @db.Decimal(12, 2)
  adjustmentReason      String?       @map("adjustment_reason") @db.VarChar(255)
  finalPrice            Decimal?      @map("final_price") @db.Decimal(12, 2)
  approvedByDispatcher  String?       @map("approved_by_dispatcher") @db.Uuid
  approvedAt            DateTime?     @map("approved_at") @db.Timestamptz()
  quotedPrice           Decimal?      @map("quoted_price") @db.Decimal(12, 2)
  quotedEstimatedTime   String?       @map("quoted_estimated_time") @db.VarChar(50)
  quoteNotes            String?       @map("quote_notes")
  quotedAt              DateTime?     @map("quoted_at") @db.Timestamptz()
  quoteVersion          Int           @default(0) @map("quote_version")
  customerDecisionAt    DateTime?     @map("customer_decision_at") @db.Timestamptz()
  customerDecisionNote  String?       @map("customer_decision_note")
  cargoImageUrl         String?       @map("cargo_image_url")
  cargoImagePublicId    String?       @map("cargo_image_public_id")
  loadType              CargoLoadType @default(FTL) @map("load_type")
  status                RequestStatus @default(Pending)
  driverId              String?       @map("driver_id") @db.Uuid
  truckId               String?       @map("truck_id") @db.Uuid
  dispatcherId          String?       @map("dispatcher_id") @db.Uuid
  bookingChannel        String        @default("ONLINE") @map("booking_channel") @db.VarChar(40)
  assignedByAdminId     String?       @map("assigned_by_admin_id") @db.Uuid
  assignedAt            DateTime?     @map("assigned_at") @db.Timestamptz()
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  customer   User   @relation("CargoRequestCustomer", fields: [customerId], references: [id])
  driver     User?  @relation("CargoRequestDriver", fields: [driverId], references: [id])
  dispatcher User?  @relation("CargoRequestDispatcher", fields: [dispatcherId], references: [id])
  assignedByAdmin User? @relation("PhoneBookingAssignedBy", fields: [assignedByAdminId], references: [id], onDelete: SetNull)
  truck      Truck? @relation(fields: [truckId], references: [id])
  trips      Trip[]
  sharedBooking SharedTripBooking?

  @@index([status], map: "idx_cargo_requests_status")
  @@index([loadType, status], map: "idx_cargo_requests_load_type")
  @@index([customerId, createdAt], map: "idx_cargo_requests_customer_created")
  @@index([driverId], map: "idx_cargo_requests_driver")
  @@index([dispatcherId], map: "idx_cargo_requests_dispatcher")
  @@index([bookingChannel, status], map: "idx_cargo_requests_booking_channel_status")
  @@index([createdAt], map: "idx_cargo_requests_created_at")
  @@map("cargo_requests")
}

model Trip {
  id               String     @id
  cargoRequestId   String?    @map("cargo_request_id")
  customerId       String     @map("customer_id") @db.Uuid
  driverId         String?    @map("driver_id") @db.Uuid
  dispatcherId     String?    @map("dispatcher_id") @db.Uuid
  truckId          String?    @map("truck_id") @db.Uuid
  pickup           String
  destination      String
  distance         String?
  estimatedTime    String?    @map("estimated_time")
  status           TripStatus @default(Pending)
  fare             Decimal    @default(0) @db.Decimal(12, 2)
  deliveryProofUrl String?    @map("delivery_proof_url")
  signatureUrl     String?    @map("signature_url")
  deliveryConfirmedAt DateTime? @map("delivery_confirmed_at") @db.Timestamptz()
  lastLat          Float?     @map("last_lat")
  lastLng          Float?     @map("last_lng")
  lastLocationAt   DateTime?  @map("last_location_at") @db.Timestamptz()
  lastSpeedKmh     Float?     @map("last_speed_kmh")
  lastHeading      Float?     @map("last_heading")
  lastAccuracyM    Float?     @map("last_accuracy_m")
  distanceTraveledKm Decimal? @map("distance_traveled_km") @db.Decimal(12, 2)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  cargoRequest CargoRequest? @relation(fields: [cargoRequestId], references: [id])
  customer     User          @relation("TripCustomer", fields: [customerId], references: [id])
  driver       User?         @relation("TripDriver", fields: [driverId], references: [id])
  dispatcher   User?         @relation("TripDispatcher", fields: [dispatcherId], references: [id])
  truck        Truck?        @relation(fields: [truckId], references: [id])
  payments     Payment[]
  earnings     Earning[]
  feedback     TripFeedback?
  feedbackToken DeliveryFeedbackToken?
  locationPoints TripLocationPoint[]
  events         TripEvent[]

  @@index([status], map: "idx_trips_status")
  @@index([customerId], map: "idx_trips_customer")
  @@index([driverId, status], map: "idx_trips_driver_status")
  @@index([dispatcherId], map: "idx_trips_dispatcher")
  @@index([cargoRequestId], map: "idx_trips_cargo_request")
  @@index([createdAt], map: "idx_trips_created_at")
  @@map("trips")
}

model TripLocationPoint {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId     String   @map("trip_id")
  lat        Float
  lng        Float
  speedKmh   Float?   @map("speed_kmh")
  heading    Float?
  accuracyM  Float?   @map("accuracy_m")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz()

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt], map: "idx_trip_location_points_trip")
  @@map("trip_location_points")
}

model TripEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String?  @map("trip_id")
  truckId   String?  @map("truck_id") @db.Uuid
  type      String   @db.VarChar(60)
  message   String
  lat       Float?
  lng       Float?
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  trip  Trip?  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  truck Truck? @relation(fields: [truckId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt], map: "idx_trip_events_trip")
  @@index([truckId, createdAt], map: "idx_trip_events_truck")
  @@index([type, createdAt], map: "idx_trip_events_type")
  @@map("trip_events")
}

model Geofence {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(150)
  zoneType    String   @map("zone_type") @db.VarChar(40)
  centerLat   Float    @map("center_lat")
  centerLng   Float    @map("center_lng")
  radiusM     Float    @map("radius_m")
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([active], map: "idx_geofences_active")
  @@map("geofences")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read], map: "idx_notifications_user")
  @@index([createdAt], map: "idx_notifications_created_at")
  @@map("notifications")
}

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId                String?       @map("trip_id")
  customerId            String?       @map("customer_id") @db.Uuid
  amount                Decimal       @db.Decimal(12, 2)
  amountPaid            Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status                PaymentStatus @default(Pending)
  method                String?       @default("waafipay")
  currency              String?       @default("SLSH")
  referenceId           String?       @unique @map("reference_id")
  description           String?
  provider              String?       @default("waafipay")
  providerTransactionId String?       @map("provider_transaction_id")
  providerResponse      Json?         @map("provider_response")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  trip     Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)
  customer User? @relation("PaymentCustomer", fields: [customerId], references: [id])
  earnings Earning[]

  @@index([status], map: "idx_payments_status")
  @@index([customerId, createdAt], map: "idx_payments_customer_created")
  @@index([createdAt], map: "idx_payments_created_at")
  @@map("payments")
}

model Earning {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId       String?       @map("payment_id") @db.Uuid
  tripId          String?       @map("trip_id")
  recipientId     String?       @map("recipient_id") @db.Uuid
  recipientRole   EarningRole   @map("recipient_role")
  amount          Decimal       @db.Decimal(12, 2)
  percent         Decimal       @db.Decimal(5, 2)
  currency        String?       @default("SLSH")
  status          EarningStatus @default(Available)
  payoutMethod    String?       @map("payout_method")
  payoutReference String?       @map("payout_reference")
  paidOutAt       DateTime?     @map("paid_out_at") @db.Timestamptz()
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  recipient User?    @relation("EarningRecipient", fields: [recipientId], references: [id])

  @@index([recipientId, status], map: "idx_earnings_recipient")
  @@map("earnings")
}

model Setting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("settings")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("actor_id") @db.Uuid
  action      String
  entityType  String?  @map("entity")
  entityId    String?  @map("entity_id")
  description String?
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  status      String   @default("Success")
  meta        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "idx_audit_logs_user_created")
  @@index([action, createdAt], map: "idx_audit_logs_action_created")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

model VerificationCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  codeHash  String    @map("code")
  purpose   String
  payload   Json?
  attempts  Int       @default(0)
  maxAttempts Int     @default(5) @map("max_attempts")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([email, purpose, expiresAt], map: "idx_verification_codes_lookup")
  @@map("verification_codes")
}

model TripFeedback {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId        String   @unique @map("trip_id")
  customerId    String   @map("customer_id") @db.Uuid
  driverId      String?  @map("driver_id") @db.Uuid
  rating        Int
  productRating Int?     @map("product_rating")
  driverBehaviourRating Int? @map("driver_behaviour_rating")
  deliverySpeedRating Int? @map("delivery_speed_rating")
  cargoConditionRating Int? @map("cargo_condition_rating")
  cargoReceivedSafely Boolean? @map("cargo_received_safely")
  reportProblem Boolean @default(false) @map("report_problem")
  complaintStatus String @default("None") @map("complaint_status")
  senderName    String?  @map("sender_name")
  senderPhone   String?  @map("sender_phone")
  receiverName  String?  @map("receiver_name")
  receiverPhone String?  @map("receiver_phone")
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  trip     Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  customer User  @relation("FeedbackCustomer", fields: [customerId], references: [id])
  driver   User? @relation("FeedbackDriver", fields: [driverId], references: [id])

  @@index([driverId], map: "idx_trip_feedback_driver")
  @@map("trip_feedback")
}

model DeliveryFeedbackToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String    @unique @map("trip_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([expiresAt, usedAt], map: "idx_delivery_feedback_tokens_validity")
  @@map("delivery_feedback_tokens")
}

model SmsNotification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType        String    @map("entity_type")
  entityId          String    @map("entity_id")
  event             String
  recipientName     String?   @map("recipient_name")
  recipientPhone    String    @map("recipient_phone")
  message           String
  sentByUserId      String?   @map("sent_by_user_id") @db.Uuid
  sentByName        String?   @map("sent_by_name")
  status            String    @default("Pending")
  providerMessageId String?   @map("provider_message_id")
  failureReason     String?   @map("failure_reason")
  attempts          Int       @default(0)
  nextRetryAt       DateTime? @map("next_retry_at") @db.Timestamptz()
  sentAt            DateTime? @map("sent_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  sentBy User? @relation("SmsSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@unique([event, recipientPhone, entityType, entityId], map: "uq_sms_event_recipient_entity")
  @@index([status, nextRetryAt], map: "idx_sms_retry_queue")
  @@map("sms_notifications")
}

model SupportComplaint {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  againstRole    String   @map("against_role")
  againstUserId  String?  @map("against_user_id") @db.Uuid
  againstName    String?  @map("against_name")
  referenceType  String   @map("reference_type")
  referenceId    String   @map("reference_id")
  subject        String?
  message        String
  status         String   @default("Open")
  adminNote      String?  @map("admin_note")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  customer    User  @relation("SupportComplaintCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  againstUser User? @relation("SupportComplaintAgainst", fields: [againstUserId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt], map: "idx_support_complaints_customer")
  @@index([status, createdAt], map: "idx_support_complaints_status")
  @@map("support_complaints")
}

model SharedTrip {
  id              String    @id
  driverId        String    @map("driver_id") @db.Uuid
  truckId         String?   @map("truck_id") @db.Uuid
  pickup          String
  destination     String
  fromRegion      String?   @map("from_region")
  fromDistrict    String?   @map("from_district")
  toRegion        String?   @map("to_region")
  toDistrict      String?   @map("to_district")
  departureDate   DateTime? @map("departure_date") @db.Date
  durationAmount  Decimal?  @map("duration_amount") @db.Decimal(12, 2)
  durationUnit    String?   @map("duration_unit")
  totalCapacityTons Decimal @map("total_capacity_tons") @db.Decimal(12, 2)
  availableTons   Decimal   @map("available_tons") @db.Decimal(12, 2)
  pricePerTon     Decimal?  @map("price_per_ton") @db.Decimal(12, 2)
  notes           String?
  status          String    @default("Open for booking")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  driver   User                @relation(fields: [driverId], references: [id])
  truck    Truck?              @relation(fields: [truckId], references: [id])
  bookings SharedTripBooking[]

  @@index([driverId, status], map: "idx_shared_trips_driver")
  @@index([status, departureDate], map: "idx_shared_trips_status")
  @@map("shared_trips")
}

model SharedTripBooking {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sharedTripId   String   @map("shared_trip_id")
  customerId     String   @map("customer_id") @db.Uuid
  cargoRequestId String?  @unique @map("cargo_request_id")
  weightTons     Decimal  @map("weight_tons") @db.Decimal(12, 2)
  status         String   @default("Pending")
  pickupOrder    Int?     @map("pickup_order")
  deliveryOrder  Int?     @map("delivery_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  sharedTrip   SharedTrip    @relation(fields: [sharedTripId], references: [id], onDelete: Cascade)
  customer     User          @relation(fields: [customerId], references: [id])
  cargoRequest CargoRequest? @relation(fields: [cargoRequestId], references: [id], onDelete: SetNull)

  @@index([sharedTripId], map: "idx_shared_trip_bookings_trip")
  @@index([customerId], map: "idx_shared_trip_bookings_customer")
  @@map("shared_trip_bookings")
}
