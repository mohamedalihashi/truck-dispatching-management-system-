VITE_API_URL=/api
VITE_SOCKET_URL=

# Public contact shown on /contact and privacy pages
VITE_SUPPORT_EMAIL=support@truckdispatch.so
VITE_SUPPORT_PHONE=+252 61 XXX XXXX

# Local dev: Vite proxies /api and /socket.io to backend (port 4000).
# Vercel production: same-origin /api (no change needed).

# Netlify production (API + realtime on Render):
# VITE_API_URL=https://your-api.onrender.com/api
# VITE_SOCKET_URL=https://your-api.onrender.com

# Map: OpenStreetMap by default. Set VITE_MAP_PROVIDER=google + key for Google Maps.
# VITE_MAP_PROVIDER=google
# VITE_GOOGLE_MAPS_API_KEY=
